{
  "openapi": "3.0.0",
  "info": {
    "title": "DEISI Shop API",
    "description": "API para a loja DEISI Shop incluindo endpoints para produtos, categorias e compras.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://deisishop.pythonanywhere.com"
    }
  ],
  "tags": [
    {
      "name": "shop",
      "description": "Endpoints disponíveis da DEISIshop"
    }
  ],
  "paths": {
    "/categories/": {
      "get": {
        "tags": ["shop"],
        "summary": "Retorna todas as categorias de produtos existentes na loja.",
        "operationId": "getCategories",
        "responses": {
          "200": {
            "description": "Lista de categorias disponíveis.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "example": [
                  "T-shirts",
                  "Canecas",
                  "Meias"
                ]
              }
            }
          }
        }
      }
    },

    "/products/": {
      "get": {
        "tags": ["shop"],
        "summary": "Retorna todos os produtos existentes na loja.",
        "operationId": "getAllProducts",
        "responses": {
          "200": {
            "description": "Lista de produtos na loja.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Product"
                  }
                },
                "example": [
                  {
                    "id": 1,
                    "title": "A Matemática do Binário - Fácil!",
                    "price": 22.5,
                    "description": "Mostra ao mundo que percebes de matemática fora da caixa!...",
                    "category": "T-shirts",
                    "image": "https://deisishop.pythonanywhere.com/media/produto_imagens/tshirt-1-1.png",
                    "rating": {
                      "rate": 4.7,
                      "count": 200
                    }
                  }
                ]
              }
            }
          }
        }
      }
    },

    "/products/{id}": {
      "get": {
        "tags": ["shop"],
        "summary": "Retorna um produto específico da loja.",
        "operationId": "getProductById",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" }
          }
        ],
        "responses": {
          "200": {
            "description": "Produto encontrado.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Product" },
                "example": {
                  "id": 1,
                  "title": "A Matemática do Binário - Fácil!",
                  "price": 22.5,
                  "description": "Mostra ao mundo que percebes de matemática fora da caixa!...",
                  "category": "T-shirts",
                  "image": "https://deisishop.pythonanywhere.com/media/produto_imagens/tshirt-1-1.png",
                  "rating": {
                    "rate": 4.7,
                    "count": 200
                  }
                }
              }
            }
          }
        }
      }
    },

    "/buy/": {
      "post": {
        "tags": ["shop"],
        "summary": "Recebe lista de produtos, indica se é estudante e cupão, e retorna o custo final.",
        "operationId": "postBuy",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "products": {
                    "type": "array",
                    "items": { "type": "integer" }
                  },
                  "student": {
                    "type": "boolean"
                  },
                  "coupon": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  }
                },
                "required": ["products", "student", "coupon", "name"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Retorna o custo total e a referência.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "totalCost": { "type": "string" },
                    "reference": { "type": "string" },
                    "message": { "type": "string" },
                    "error": { "type": "string" }
                  }
                },
                "example": {
                  "totalCost": "23.43",
                  "reference": "201124-0004",
                  "message": "Excelente escolha, Maria Lisboa! A DEISI Shop agradece a sua preferência!",
                  "error": ""
                }
              }
            }
          },
          "400": {
            "description": "Erro de validação ou dados inválidos.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": { "type": "string" }
                  }
                },
                "example": { "error": "No products provided" }
              }
            }
          },
          "405": {
            "description": "Método HTTP inválido.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": { "type": "string" }
                  }
                },
                "example": { "error": "Invalid HTTP method. Use HTTP POST." }
              }
            }
          }
        }
      }
    }
  },

  "components": {
    "schemas": {
      "Product": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "title": { "type": "string" },
          "price": { "type": "number", "format": "float" },
          "description": { "type": "string" },
          "category": { "type": "string" },
          "image": { "type": "string", "format": "uri" },
          "rating": { "$ref": "#/components/schemas/Rating" }
        }
      },
      "Rating": {
        "type": "object",
        "properties": {
          "rate": { "type": "number", "format": "float" },
          "count": { "type": "integer" }
        }
      }
    }
  }
}
